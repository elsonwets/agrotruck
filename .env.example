# Écrit automatiquement par `npx convex dev` dans .env.local
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# URL publique du site (canonique, sitemap, Open Graph). Sur Vercel : le domaine final.
VITE_SITE_URL=https://agro-truck.com

# Vercel uniquement : clé de déploiement Convex de production (build : npx convex deploy --cmd 'pnpm build')
CONVEX_DEPLOY_KEY=
