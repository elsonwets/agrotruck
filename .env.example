# URL de l'API externe qui retourne la liste publique des camions.
AGROTRUCK_DIRECTORY_API_URL=https://api.example.com/public/trucks
# Facultatif si l'API est protégée côté serveur.
AGROTRUCK_DIRECTORY_API_TOKEN=
AGROTRUCK_DIRECTORY_REVALIDATE_SECONDS=300

# Facultatif : domaine personnalisé. Vercel fournit automatiquement son domaine de production.
NEXT_PUBLIC_SITE_URL=https://agro-truck.com
# Numéro WhatsApp qui reçoit les demandes d'inscription de camions.
NEXT_PUBLIC_AGROTRUCK_WHATSAPP=+245955000100
