# Copiez la chaîne fournie par le bouton Connect dans votre projet Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
VERIFICATION_CODE_SECRET=replace-with-a-long-random-secret
# Facultatif : domaine personnalisé. Vercel fournit automatiquement son domaine de production.
NEXT_PUBLIC_SITE_URL=https://agrotruck.example
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=AgroTruck <no-reply@your-verified-domain.com>
ADMIN_EMAILS=admin@agrotruck.com
# Activez seulement après avoir configuré et fait approuver le modèle AUTHENTICATION dans WhatsApp Manager.
NEXT_PUBLIC_WHATSAPP_AUTH_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=agrotruck_login_code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_API_VERSION=v23.0
